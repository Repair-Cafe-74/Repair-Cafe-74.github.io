---
import { CalendarDays, MapPin } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import type { AgendaEntry } from "../lib/agenda";

type Props = {
  entry: AgendaEntry;
  event?: CollectionEntry<"events"> | null;
  permanence?: CollectionEntry<"permanences"> | null;
};

const { entry, event, permanence } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("fr-FR", {
  dateStyle: "full",
  timeStyle: entry.startsAt ? "short" : undefined,
}).format(entry.date);
const title = entry.kind === "event" && event ? event.data.title : entry.title;
const locationText = entry.kind === "event" && event ? event.data.location : entry.location;
const description = entry.kind === "event" && event
  ? event.data.summary
  : permanence?.data.summary ?? "";
const label = entry.kind === "event" ? "Événement" : "Permanence";
---

<article class="rounded-md border border-ink/10 bg-white p-5 shadow-sm">
  <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-clay">
    <CalendarDays size={17} aria-hidden="true" />
    <time datetime={entry.date.toISOString()}>{formattedDate}</time>
  </p>
  <span class="inline-flex rounded-full bg-mist px-2 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-ink/70">
    {label}
  </span>
  <h2 class="mt-3 text-xl font-semibold">{title}</h2>
  <p class="mt-2 flex items-center gap-2 text-sm text-ink/68">
    <MapPin size={17} aria-hidden="true" />
    {locationText}
  </p>
  {description && <p class="mt-4 leading-7 text-ink/72">{description}</p>}
</article>
