---
import { CalendarDays, MapPin } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  event: CollectionEntry<"events">;
};

const { event } = Astro.props;
const date = event.data.date;
const formattedDate = new Intl.DateTimeFormat("fr-FR", {
  dateStyle: "full",
  timeStyle: "short",
}).format(date);
---

<article class="rounded-md border border-ink/10 bg-white p-5 shadow-sm">
  <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-clay">
    <CalendarDays size={17} aria-hidden="true" />
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </p>
  <h2 class="text-xl font-semibold">{event.data.title}</h2>
  <p class="mt-2 flex items-center gap-2 text-sm text-ink/68">
    <MapPin size={17} aria-hidden="true" />
    {event.data.location}
  </p>
  <p class="mt-4 leading-7 text-ink/72">{event.data.summary}</p>
  <div class="prose-content mt-4 text-sm text-ink/70">
    <slot />
  </div>
</article>
