---
import { GTM_ID } from "../config/analytics";
---

<!-- Google Consent Mode v2 (avant GTM) -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  function hasStoredAnalyticsConsent() {
    try {
      var match = document.cookie.match(/(?:^|;\s*)cc_cookie=([^;]*)/);
      if (!match) return false;

      var data = JSON.parse(decodeURIComponent(match[1]));
      return (
        Array.isArray(data.categories) && data.categories.indexOf("analytics") !== -1
      );
    } catch (error) {
      return false;
    }
  }

  var analyticsAlreadyGranted = hasStoredAnalyticsConsent();

  gtag("consent", "default", {
    ad_personalization: "denied",
    ad_storage: "denied",
    ad_user_data: "denied",
    analytics_storage: analyticsAlreadyGranted ? "granted" : "denied",
    functionality_storage: "denied",
    personalization_storage: "denied",
    security_storage: "granted",
    wait_for_update: analyticsAlreadyGranted ? 0 : 2000,
  });
  gtag("set", "ads_data_redaction", true);
</script>

<!-- Google Tag Manager -->
<script is:inline define:vars={{ gtmId: GTM_ID }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != "dataLayer" ? "&l=" + l : "";
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, "script", "dataLayer", gtmId);
</script>
