---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"news">;
  hidden?: boolean;
};

const { entry, hidden = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(entry.data.date);
---

<article
  class:list={["news-card rounded-md border border-ink/10 bg-white p-5 shadow-sm", hidden && "hidden"]}
  data-news-card
>
  <p class="text-sm text-ink/60">
    <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true"> · </span>
    <span>{entry.data.author}</span>
  </p>
  <h2 class="mt-2 text-xl font-semibold">
    <a class="hover:text-moss" href={`/actualites/${entry.slug}`}>{entry.data.title}</a>
  </h2>
  <p class="mt-3 leading-7 text-ink/72">{entry.data.summary}</p>
  <a class="mt-4 inline-flex text-sm font-semibold text-moss hover:text-ink" href={`/actualites/${entry.slug}`}>
    Lire l'article
  </a>
</article>
