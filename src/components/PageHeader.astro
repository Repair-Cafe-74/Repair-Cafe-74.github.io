---
type Props = {
  eyebrow?: string;
  title: string;
  description: string;
};

const { eyebrow, title, description } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-10 pt-12 sm:px-6 lg:px-8">
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-clay">{eyebrow}</p>}
  <h1 class="max-w-4xl text-4xl font-semibold leading-tight text-ink sm:text-5xl">{title}</h1>
  <p class="mt-5 max-w-3xl text-lg leading-8 text-ink/72">{description}</p>
</section>
