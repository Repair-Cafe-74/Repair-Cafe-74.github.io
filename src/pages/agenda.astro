---
import { getCollection } from "astro:content";
import { CalendarDays, ChevronLeft, ChevronRight, Clock, MapPin, X } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { buildAgendaEntries, buildAgendaMonths } from "../lib/agenda";

const events = (await getCollection("events")).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const locations = (await getCollection("locations")).sort((a, b) => a.data.name.localeCompare(b.data.name, "fr"));
const entries = buildAgendaEntries(events, locations);
const calendarMonths = buildAgendaMonths(entries);
const upcomingEvents = events.filter((event) => entries.some((entry) => entry.kind === "event" && entry.sourceId === event.id));

const monthFormatter = new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric" });
const weekdayFormatter = new Intl.DateTimeFormat("fr-FR", { weekday: "short" });
const fullDateFormatter = new Intl.DateTimeFormat("fr-FR", { dateStyle: "full" });
const timeFormatter = new Intl.DateTimeFormat("fr-FR", { hour: "2-digit", minute: "2-digit" });
const weekdays = Array.from({ length: 7 }, (_, index) => {
  const date = new Date(Date.UTC(2026, 5, 1 + index));
  return weekdayFormatter.format(date);
});

const formatEntryTime = (date: Date, startsAt: string | null) => startsAt ? timeFormatter.format(date) : "Horaire à confirmer";
const formatEntryTitle = (entry: (typeof entries)[number]) => {
  if (entry.kind !== "permanence") return entry.title;

  return entry.title
    .replace(/^Repair Café\s+(?:(?:des|de|du|d’|d')\s*)?/i, "")
    .trim();
};
const eventDetails = await Promise.all(upcomingEvents.map(async (event) => ({
  event,
  hasContent: (event.body?.trim().length ?? 0) > 0,
  ...(await event.render()),
})));
const locationDetails = await Promise.all(locations.map(async (location) => ({
  location,
  hasContent: (location.body?.trim().length ?? 0) > 0,
  ...(await location.render()),
})));
---

<BaseLayout title="Agenda">
  <PageHeader eyebrow="Agenda" title="Quand nous retrouver ?" description="Retrouvez les permanences des Repair Cafés et autres événements des 12 prochains mois. Attention aux mois de vacances scolaires ainsi qu'aux jours fériés: certains Repair Cafés peuvent être fermés." />
  <section class="agenda-view mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-5" data-agenda-calendar>
      <div class="agenda-toolbar flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div class="agenda-legend flex flex-wrap items-center gap-3 text-sm font-medium text-ink/72" aria-label="Filtres de l'agenda">
          <button class="agenda-filter inline-flex items-center gap-2 rounded border border-ink/10 bg-white px-3 py-2 shadow-sm" type="button" data-agenda-filter="permanence" aria-pressed="true">
            <span class="h-3 w-3 rounded-sm bg-leaf"></span>Permanence
          </button>
          <button class="agenda-filter inline-flex items-center gap-2 rounded border border-ink/10 bg-white px-3 py-2 shadow-sm" type="button" data-agenda-filter="event" aria-pressed="true">
            <span class="h-3 w-3 rounded-sm bg-clay"></span>Événement
          </button>
        </div>

        <div class="agenda-month-nav flex w-full items-center justify-between gap-3 rounded-md border border-ink/10 bg-white px-3 py-3 shadow-sm sm:px-5 md:w-auto md:min-w-[22rem]">
          <button class="agenda-month-button inline-flex h-10 w-10 shrink-0 items-center justify-center rounded border border-ink/10 text-ink/74 hover:bg-mist hover:text-ink disabled:cursor-not-allowed disabled:opacity-35" type="button" data-agenda-prev aria-label="Mois précédent">
            <ChevronLeft size={20} aria-hidden="true" />
          </button>
          <h2 class="text-center text-xl font-semibold capitalize sm:text-2xl" data-agenda-title>{monthFormatter.format(calendarMonths[0].titleDate)}</h2>
          <button class="agenda-month-button inline-flex h-10 w-10 shrink-0 items-center justify-center rounded border border-ink/10 text-ink/74 hover:bg-mist hover:text-ink disabled:cursor-not-allowed disabled:opacity-35" type="button" data-agenda-next aria-label="Mois suivant">
            <ChevronRight size={20} aria-hidden="true" />
          </button>
        </div>
      </div>

      <aside class="agenda-popover hidden rounded-md border border-ink/10 bg-white p-5 shadow-md" data-agenda-popover aria-live="polite">
        <button class="agenda-popover-close ml-auto flex h-9 w-9 items-center justify-center rounded border border-ink/10 text-ink/70 hover:bg-mist hover:text-ink" type="button" data-agenda-close aria-label="Fermer le detail">
          <X size={18} aria-hidden="true" />
        </button>
        <div class="agenda-popover-content" data-agenda-popover-content></div>
      </aside>

      <div class="agenda-months">
        {calendarMonths.map((month, monthIndex) => (
          <article class={`agenda-month overflow-hidden rounded-md border border-ink/10 bg-white shadow-sm ${monthIndex === 0 ? "is-active" : ""}`} data-agenda-month data-month-title={monthFormatter.format(month.titleDate)}>
            <div class="agenda-weekdays grid grid-cols-[3.25rem_repeat(7,minmax(0,1fr))] border-b border-ink/10 bg-paper text-center text-xs font-semibold uppercase text-ink/58">
              <div class="border-r border-ink/10 px-2 py-3">Sem.</div>
              {weekdays.map((day) => <div class="border-r border-ink/10 px-3 py-3 last:border-r-0">{day}</div>)}
            </div>
            <div class="agenda-month-grid grid grid-cols-[3.25rem_repeat(7,minmax(0,1fr))]">
              {month.weeks.map((week) => (
                <>
                  <div class="agenda-week-number border-r border-t border-ink/10 bg-paper/70 px-2 py-3 text-center text-xs font-semibold text-ink/58">
                    S{week.weekNumber}
                  </div>
                  {week.days.map((day) => (
                    <div class={`agenda-day min-h-32 border-r border-t border-ink/10 p-3 last:border-r-0 ${day.date ? "bg-white" : "agenda-empty-day bg-mist/35"}`}>
                      {day.date && (
                        <>
                          <p class="agenda-day-number mb-2 text-sm font-semibold text-ink/68">
                            <span class="agenda-mobile-week">S{week.weekNumber} · </span>
                            <span class="agenda-mobile-weekday">{weekdayFormatter.format(day.date)} </span>{day.date.getDate()}
                          </p>
                          <div class="grid gap-2">
                            {day.entries.map((entry) => (
                              <button
                                class={`agenda-entry agenda-entry-${entry.kind} rounded px-3 py-2 text-left text-paper shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus-visible:translate-y-0`}
                                type="button"
                                data-agenda-kind={entry.kind}
                                data-agenda-detail={entry.detailId}
                              >
                                <span class="flex items-center gap-1.5 text-xs font-semibold">
                                  <Clock size={13} aria-hidden="true" />
                                  {formatEntryTime(entry.date, entry.startsAt)}
                                </span>
                                <span class="mt-1 block text-sm font-semibold leading-snug">{formatEntryTitle(entry)}</span>
                                {entry.kind === "event" && entry.location && <span class="mt-1 block text-xs leading-snug text-paper/88">{entry.location}</span>}
                              </button>
                            ))}
                          </div>
                        </>
                      )}
                    </div>
                  ))}
                </>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="hidden" data-agenda-details>
        {locationDetails.map(({ location, Content, hasContent }) => (
          <article id={`agenda-location-${location.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`} class="agenda-detail-template">
            <p class="mb-3 inline-flex rounded bg-leaf/12 px-2 py-1 text-xs font-semibold uppercase text-leaf">Permanence</p>
            <h3 class="text-2xl font-semibold">{location.data.name}</h3>
            <p class="mt-4 flex items-start gap-2 text-sm leading-6 text-ink/70">
              <MapPin class="mt-0.5 shrink-0 text-clay" size={17} aria-hidden="true" />
              {location.data.address}
            </p>
            <p class="mt-2 flex items-start gap-2 text-sm font-semibold text-ink/80">
              <Clock class="mt-0.5 shrink-0 text-leaf" size={17} aria-hidden="true" />
              {location.data.hours}
            </p>
            {location.data.link && (
              <a class="mt-4 inline-flex text-sm font-semibold text-moss hover:text-ink" href={location.data.link} target="_blank" rel="noreferrer">
                Site web
              </a>
            )}
            {hasContent && (
              <div class="prose-content mt-5 text-sm text-ink/75">
                <Content />
              </div>
            )}
          </article>
        ))}

        {eventDetails.map(({ event, Content, hasContent }) => (
          <article id={`agenda-event-${event.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`} class="agenda-detail-template">
            <p class="mb-3 inline-flex rounded bg-clay/12 px-2 py-1 text-xs font-semibold uppercase text-clay">Événement</p>
            <h3 class="text-2xl font-semibold">{event.data.title}</h3>
            <p class="mt-4 flex items-start gap-2 text-sm font-semibold text-ink/80">
              <CalendarDays class="mt-0.5 shrink-0 text-clay" size={17} aria-hidden="true" />
              <time datetime={event.data.date.toISOString()}>{fullDateFormatter.format(event.data.date)} à {timeFormatter.format(event.data.date)}</time>
            </p>
            <p class="mt-2 flex items-start gap-2 text-sm leading-6 text-ink/70">
              <MapPin class="mt-0.5 shrink-0 text-clay" size={17} aria-hidden="true" />
              {event.data.location}
            </p>
            <p class="mt-4 leading-7 text-ink/72">{event.data.summary}</p>
            {hasContent && (
              <div class="prose-content mt-4 text-sm text-ink/70">
                <Content />
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const calendar = document.querySelector("[data-agenda-calendar]");

    if (calendar) {
      const months = Array.from(calendar.querySelectorAll<HTMLElement>("[data-agenda-month]"));
      const title = calendar.querySelector<HTMLElement>("[data-agenda-title]");
      const previousButton = calendar.querySelector<HTMLButtonElement>("[data-agenda-prev]");
      const nextButton = calendar.querySelector<HTMLButtonElement>("[data-agenda-next]");
      const popover = calendar.querySelector("[data-agenda-popover]");
      const popoverContent = calendar.querySelector("[data-agenda-popover-content]");
      const closeButton = calendar.querySelector("[data-agenda-close]");
      const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-agenda-filter]"));
      const visibleKinds = new Set(["permanence", "event"]);
      let activeMonth = 0;

      const showMonth = (index: number) => {
        activeMonth = Math.max(0, Math.min(index, months.length - 1));

        months.forEach((month, monthIndex) => {
          month.classList.toggle("is-active", monthIndex === activeMonth);
        });

        if (title) title.textContent = months[activeMonth]?.getAttribute("data-month-title") ?? "";
        if (previousButton) previousButton.disabled = activeMonth === 0;
        if (nextButton) nextButton.disabled = activeMonth === months.length - 1;
      };

      const closePopover = () => {
        popover?.classList.add("hidden");
        if (popoverContent) popoverContent.innerHTML = "";
      };

      const updateVisibleEntries = () => {
        calendar.querySelectorAll<HTMLElement>("[data-agenda-kind]").forEach((entry) => {
          entry.hidden = !visibleKinds.has(entry.dataset.agendaKind ?? "");
        });

        calendar.querySelectorAll<HTMLElement>(".agenda-day").forEach((day) => {
          const hasVisibleEntry = Boolean(day.querySelector("[data-agenda-kind]:not([hidden])"));
          const hasEntry = Boolean(day.querySelector("[data-agenda-kind]"));
          day.classList.toggle("is-filtered-empty", hasEntry && !hasVisibleEntry);
        });
      };

      previousButton?.addEventListener("click", () => {
        showMonth(activeMonth - 1);
        closePopover();
      });

      nextButton?.addEventListener("click", () => {
        showMonth(activeMonth + 1);
        closePopover();
      });

      closeButton?.addEventListener("click", closePopover);

      filters.forEach((filter) => {
        filter.addEventListener("click", () => {
          const kind = filter.dataset.agendaFilter;
          if (!kind) return;

          if (visibleKinds.has(kind)) {
            visibleKinds.delete(kind);
          } else {
            visibleKinds.add(kind);
          }

          filter.setAttribute("aria-pressed", String(visibleKinds.has(kind)));
          closePopover();
          updateVisibleEntries();
        });
      });

      calendar.addEventListener("click", (event) => {
        const trigger = event.target instanceof Element ? event.target.closest("[data-agenda-detail]") : null;
        if (!trigger || !(trigger instanceof HTMLElement)) return;

        const detail = document.getElementById(trigger.dataset.agendaDetail ?? "");
        if (!detail || !popoverContent || !popover) return;

        popoverContent.innerHTML = detail.innerHTML;
        popover.classList.remove("hidden");
        popover.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });

      showMonth(0);
      updateVisibleEntries();
    }
  </script>
</BaseLayout>
