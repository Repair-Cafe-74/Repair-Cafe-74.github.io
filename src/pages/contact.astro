---
import { Mail, PhoneCall } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout title="Contact" description="Envie de participer ou de poser une question ? N'hésitez pas à nous contacter !">
  <PageHeader eyebrow="Contact" title="Envie de participer ou de poser une question ?" description="N'hésitez pas à nous contacter !" />
  <section class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 md:grid-cols-[1fr_1fr] lg:px-8">
    <article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm">
      <h2 class="flex items-center gap-2 text-xl font-semibold"><Mail size={20} aria-hidden="true" /> Email</h2>
      <a class="mt-4 inline-block text-moss hover:text-ink" href="mailto:repaircafe74@gmail.com">repaircafe74@gmail.com</a>
    </article>
    <article class="rounded-md border border-ink/10 bg-white p-6 shadow-sm">
      <h2 class="flex items-center gap-2 text-xl font-semibold"><PhoneCall size={20} aria-hidden="true" /> Téléphone</h2>
      <a class="mt-4 inline-block text-moss hover:text-ink" href="tel:0674403666">06 74 40 36 66</a>
    </article>
  </section>
</BaseLayout>
