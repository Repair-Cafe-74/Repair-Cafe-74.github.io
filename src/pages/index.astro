---
import { CalendarDays, MapPinned, Newspaper, Recycle, Wrench } from "@lucide/astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import { buildAgendaEntries } from "../lib/agenda";

const THREE_MONTHS_MS = 91 * 24 * 60 * 60 * 1000;

const events = await getCollection("events");
const permanences = await getCollection("permanences");
const locations = await getCollection("locations");
const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestNews = news[0] ?? null;
const showLatestNews = latestNews !== null && Date.now() - latestNews.data.date.valueOf() < THREE_MONTHS_MS;
const latestNewsDate = latestNews
  ? new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(latestNews.data.date)
  : "";
const agendaEntries = buildAgendaEntries(events, locations, permanences).slice(0, 2);
const eventMap = new Map(events.map((event) => [event.id, event]));
const permanenceMap = new Map(permanences.map((permanence) => [permanence.id, permanence]));
const entries = agendaEntries.map((entry) => ({
  entry,
  event: entry.kind === "event" ? eventMap.get(entry.sourceId) ?? null : null,
  permanence: entry.detailId.startsWith("agenda-permanence-") ? permanenceMap.get(entry.sourceId) ?? null : null,
}));
---

<BaseLayout 
    title="Repair Café 74 – Réparer plutôt que jeter en Haute-Savoie" 
    description="Repair Café 74 (Haute-Savoie) rassemble des bénévoles, des outils et des savoir-faire pour aider chacun à diagnostiquer, réparer et apprendre dans une ambiance simple et conviviale.">
  <section class="relative overflow-hidden bg-[url('/images/photos/2023-01-28-Repair-cafe-IUT.jpg')] bg-cover bg-center bg-no-repeat">
    <div aria-hidden="true" class="absolute inset-0 bg-paper/80"></div>
    <div class="relative z-10 mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.1fr_0.9fr] md:items-center lg:px-8">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-clay">Haute-Savoie</p>
        <h1 class="text-4xl font-semibold leading-tight sm:text-6xl">Réparer ensemble les objets du quotidien.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-ink/72">
          Repair Café 74 rassemble des bénévoles, des outils et des savoir-faire pour aider chacun à diagnostiquer, réparer et apprendre dans une ambiance simple et conviviale.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-md bg-moss px-5 py-3 text-sm font-semibold text-paper hover:bg-ink" href="/agenda">Voir les prochains ateliers</a>
          <a class="rounded-md border border-ink/15 bg-mist px-5 py-3 text-sm font-semibold hover:bg-paper" href="/carte">Trouver un lieu</a>
        </div>
      </div>
      <div class="grid gap-3 rounded-md border border-ink/10 bg-white p-5 shadow-sm">
        <div class="flex items-start gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mist text-moss"><Wrench size={22} aria-hidden="true" /></span>
          <div>
            <h2 class="font-semibold">Réparer</h2>
            <p class="mt-1 text-sm leading-6 text-ink/70">Des diagnostics collectifs pour prolonger la vie des appareils, vêtements, vélos et objets utiles.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mist text-moss"><Recycle size={22} aria-hidden="true" /></span>
          <div>
            <h2 class="font-semibold">Transmettre</h2>
            <p class="mt-1 text-sm leading-6 text-ink/70">Chaque atelier est un moment d'apprentissage, pas seulement un service de réparation.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mist text-moss"><MapPinned size={22} aria-hidden="true" /></span>
          <div>
            <h2 class="font-semibold">Rester local</h2>
            <p class="mt-1 text-sm leading-6 text-ink/70">Des permanences légères, proches des quartiers et faciles à animer par des bénévoles.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {showLatestNews && latestNews && (
    <section class="py-14">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="mb-2 flex items-center gap-2 text-sm font-semibold text-clay">
              <Newspaper size={17} aria-hidden="true" /> Actualités
            </p>
            <h2 class="text-3xl font-semibold">Dernière actualité</h2>
          </div>
          <a class="text-sm font-semibold text-moss hover:text-ink" href="/actualites">Toutes les actualités</a>
        </div>
        <article class="rounded-md border border-ink/10 bg-white p-5 shadow-sm md:p-7">
          <p class="text-sm text-ink/60">
            <time datetime={latestNews.data.date.toISOString()}>{latestNewsDate}</time>
            <span aria-hidden="true"> · </span>
            <span>{latestNews.data.author}</span>
          </p>
          <h3 class="mt-2 text-2xl font-semibold">
            <a class="hover:text-moss" href={`/actualites/${latestNews.slug}`}>{latestNews.data.title}</a>
          </h3>
          <p class="mt-3 max-w-3xl leading-7 text-ink/72">{latestNews.data.summary}</p>
          <a
            class="mt-5 inline-flex text-sm font-semibold text-moss hover:text-ink"
            href={`/actualites/${latestNews.slug}`}
          >
            Lire l'article
          </a>
        </article>
      </div>
    </section>
  )}

  <section class="bg-mist/70 py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-2 flex items-center gap-2 text-sm font-semibold text-clay"><CalendarDays size={17} aria-hidden="true" /> Agenda</p>
          <h2 class="text-3xl font-semibold">Prochains rendez-vous</h2>
        </div>
        <a class="text-sm font-semibold text-moss hover:text-ink" href="/agenda">Tout l'agenda</a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {entries.map(({ entry, event, permanence }) => (
          <EventCard entry={entry} event={event} permanence={permanence} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
