---
import { getCollection } from "astro:content";
import { ExternalLink } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const links = (await getCollection("press")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Presse">
  <PageHeader eyebrow="Presse" title="Ils parlent de nous." description="Articles, mentions et partenaires pourront être ajoutés au fil de l'eau." />
  <section class="mx-auto grid max-w-4xl gap-4 px-4 sm:px-6 lg:px-8">
    {links.map((item) => (
      <article class="rounded-md border border-ink/10 bg-white p-5 shadow-sm">
        <p class="text-sm text-ink/60">{item.data.source} - {new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(item.data.date)}</p>
        <h2 class="mt-2 text-xl font-semibold">{item.data.title}</h2>
        <a class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-moss hover:text-ink" href={item.data.url}>
          Lire la mention
          <ExternalLink size={16} aria-hidden="true" />
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
