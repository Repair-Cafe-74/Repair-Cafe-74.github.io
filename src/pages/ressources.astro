---
import { getCollection } from "astro:content";
import { Download, ExternalLink, Info } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const resources = (await getCollection("resources")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Ressources" description="Tutoriels créés par nos bénévoles pour réparer soi-même ses objets.">
  <PageHeader eyebrow="Ressources" title="Tutoriels pour réparer soi-même !" description="Trouvez-ici des tutoriels créés par nos bénévoles pour réparer soi-même vos objets." />
  <section class="mx-auto grid max-w-4xl gap-4 px-4 sm:px-6 lg:px-8">
    <aside class="rounded-md border border-moss/20 bg-mist/70 p-5 text-ink shadow-sm">
      <div class="flex gap-4">
        <Info class="mt-0.5 shrink-0 text-moss" size={22} aria-hidden="true" />
        <div>
          <h2 class="font-semibold">Bon à savoir</h2>
          <p class="mt-2 leading-7 text-ink/72">
            Le site officiel Repair Café propose aussi une sélection de tutoriels iFixit pour vous aider à diagnostiquer et réparer vos objets.
          </p>
          <a
            class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-moss hover:text-ink"
            href="https://www.repaircafe.org/fr/community/tutoriels-de-reparation/"
            target="_blank"
            rel="noreferrer"
          >
            Voir les tutoriels iFixit
            <ExternalLink size={16} aria-hidden="true" />
          </a>
        </div>
      </div>
    </aside>
    {resources.map(async (resource) => {
      const { Content } = await resource.render();
      return (
        <article class="rounded-md border border-ink/10 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-clay">{resource.data.type}</p>
              <h2 class="mt-2 text-xl font-semibold">{resource.data.title}</h2>
              <div class="prose-content mt-3 text-sm text-ink/70"><Content /></div>
            </div>
            <a class="inline-flex items-center gap-2 rounded-md bg-moss px-4 py-2 text-sm font-semibold text-paper hover:bg-ink" href={resource.data.file}>
              <Download size={17} aria-hidden="true" />
              Télécharger
            </a>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
